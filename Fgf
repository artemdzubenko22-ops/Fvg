local function hideEsp(d, ch)
    if not d then return end
    if d.nm then d.nm.Visible = false end
    if d.hb then d.hb.Visible = false end
    if d.hr then d.hr.Visible = false end
    if d.hpt then d.hpt.Visible = false end
    if d.tr then d.tr.Visible = false end
    if d.lk then d.lk.Visible = false end
    if ch then
        local hl = ch:FindFirstChild("_fnvhl")
        if hl then hl.Enabled = false end
    end
end

local function visCheck(ch, wp)
    local lc = plr.Character
    local cam = FS.cam
    if not lc or not cam then return false end
    ray.FilterDescendantsInstances = { lc, cam }
    local r = workspace:Raycast(cam.CFrame.Position, wp - cam.CFrame.Position, ray)
    return r == nil or r.Instance:IsDescendantOf(ch)
end

local function projCh(ch, name, color)
    if not ch or ch == FS.char then return nil end
    local h = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or h.Health <= 0 then return nil end
    local cam = FS.cam
    if not cam then return nil end
    local ok, cf, sz = pcall(function() return ch:GetBoundingBox() end)
    if not ok or not cf or not sz then return nil end
    local lr = FS.hrp
    local dst = lr and (lr.Position - hrp.Position).Magnitude or 0
    if dst > esp.maxDist then return nil end
    local tw = cf.Position + Vector3.new(0, sz.Y / 2, 0)
    local bw = cf.Position - Vector3.new(0, sz.Y / 2, 0)
    local ts = cam:WorldToViewportPoint(tw)
    local bs = cam:WorldToViewportPoint(bw)
    if ts.Z <= 0 or bs.Z <= 0 then return nil end
    local hh = math.abs(bs.Y - ts.Y)
    if hh < 3 then return nil end
    if esp.visOnly and not visCheck(ch, cf.Position) then return nil end
    return {
        y = ts.Y, cx = ts.X, h = hh, dist = dst, color = color,
        hp = h.Health, mhp = h.MaxHealth, name = name, char = ch,
    }
end

local function drawEsp(t, d, p)
    local col = p.color or esp.col
    if p.char then
        local ch = p.char
        local hl = ch:FindFirstChild("_fnvhl")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "_fnvhl"
            hl.Adornee = ch
            hl.Parent = ch
        end
        hl.DepthMode = esp.alwaysTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        hl.FillTransparency = 0.55
        hl.OutlineTransparency = 0
        hl.FillColor = col
        hl.OutlineColor = col
        hl.Enabled = true
    end
    if esp.name then
        d.nm.Visible = true
        d.nm.Text = p.name
        d.nm.TextSize = esp.textSize
        d.nm.Position = UDim2.fromOffset(p.cx - 120, p.y - 48)
        d.nm.Size = UDim2.fromOffset(240, 20)
    else
        d.nm.Visible = false
    end
    if esp.hp then
        local barW, barH = 90, 8
        local ratio = math.clamp(p.hp / math.max(p.mhp, 1), 0, 1)
        d.hb.Visible = true
        d.hb.Position = UDim2.fromOffset(p.cx - barW / 2, p.y - 24)
        d.hb.Size = UDim2.fromOffset(barW, barH)
        d.hr.Visible = true
        d.hr.Position = UDim2.fromOffset(1, 1)
        d.hr.Size = UDim2.fromOffset(math.max(0, (barW - 2) * ratio), barH - 2)
        d.hpt.Visible = true
        d.hpt.Text = string.format("%d/%d", math.floor(p.hp), math.floor(p.mhp))
        d.hpt.Position = UDim2.fromOffset(p.cx - barW / 2, p.y - 24)
        d.hpt.Size = UDim2.fromOffset(barW, barH)
    else
        d.hb.Visible = false
        d.hr.Visible = false
        d.hpt.Visible = false
    end
    if esp.tracer then
        d.tr.Visible = true
        local vp = FS.vp
        local fxx, fyy = vp.X / 2, vp.Y
        local dx, dy = p.cx - fxx, p.y - fyy
        local ln = math.sqrt(dx * dx + dy * dy)
        d.tr.Position = UDim2.fromOffset(fxx, fyy)
        d.tr.Size = UDim2.fromOffset(ln, 1)
        d.tr.Rotation = math.deg(math.atan2(dy, dx))
        d.tr.BackgroundColor3 = col
    else
        d.tr.Visible = false
    end
    if esp.look and p.char then
        local head = p.char:FindFirstChild("Head")
        local cam = FS.cam
        if head and cam then
            local origin = head.Position
            local a = cam:WorldToViewportPoint(origin)
            local b = cam:WorldToViewportPoint(origin + head.CFrame.LookVector * 15)
            if a.Z > 0 and b.Z > 0 then
                d.lk.Visible = true
                local dx, dy = b.X - a.X, b.Y - a.Y
                local ln = math.sqrt(dx * dx + dy * dy)
                d.lk.Position = UDim2.fromOffset(a.X, a.Y)
                d.lk.Size = UDim2.fromOffset(ln, 2)
                d.lk.Rotation = math.deg(math.atan2(dy, dx))
                d.lk.BackgroundColor3 = C.fgBright
            else
                d.lk.Visible = false
            end
        else
            d.lk.Visible = false
        end
    elseif d.lk then
        d.lk.Visible = false
    end
end

local function drawPart(p, col)
    local hl = p:FindFirstChild("_fnvph")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "_fnvph"
        hl.Adornee = p
        hl.Parent = p
    end
    hl.DepthMode = esp.alwaysTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.FillColor = col
    hl.OutlineColor = col
    hl.Enabled = true
end

local function renderEsp()
    if not esp.on then
        if espOnPrev then
            for k, d in pairs(espData) do
                local ch = nil
                if typeof(k) == "Instance" then
                    if k:IsA("Player") then ch = k.Character else ch = k end
                end
                hideEsp(d, ch)
            end
            for p in pairs(partSet) do
                local hl = p:FindFirstChild("_fnvph")
                if hl then hl:Destroy() end
            end
            espOnPrev = false
        end
        return
    end
    espOnPrev = true

    if esp.p then
        for _, t in ipairs(FS.players) do
            if t ~= plr then
                local d = ensureEsp(t)
                local p = projCh(t.Character, t.DisplayName, esp.col)
                if p then drawEsp(t, d, p) else hideEsp(d, t.Character) end
            end
        end
    else
        for _, t in ipairs(FS.players) do
            local d = espData[t]
            if d then hideEsp(d, t.Character) end
        end
    end

    if esp.b or esp.bo then
        for m in pairs(npcSet) do
            if m.Parent then
                local isBoss = bossSet[m] == true
                local show = (isBoss and esp.bo) or (not isBoss and esp.b)
                if show then
                    local col = isBoss and esp.bossCol or esp.botCol
                    local d = ensureEsp(m)
                    local p = projCh(m, m.Name, col)
                    if p then drawEsp(m, d, p) else hideEsp(d, m) end
                else
                    local d = espData[m]
                    if d then hideEsp(d, m) end
                end
            end
        end
    else
        for m in pairs(npcSet) do
            local d = espData[m]
            if d then hideEsp(d, m) end
        end
    end

    if esp.part then
        pcall(scanParts)
        for p in pairs(partSet) do
            if p.Parent and isPartRenderable(p) then drawPart(p, esp.partCol) end
        end
    else
        for p in pairs(partSet) do
            local hl = p:FindFirstChild("_fnvph")
            if hl then hl:Destroy() end
        end
    end
end

