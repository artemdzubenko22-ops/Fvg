    local glyphs = { "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" }

    local function normalizeMetric(m, v)
        if m == "fps" then return math.clamp(v / 60, 0, 1)
        elseif m == "ms" then return math.clamp(v / 50, 0, 1)
        elseif m == "ping" then return math.clamp(v / 200, 0, 1)
        elseif m == "mem" then return math.clamp(v / 2000, 0, 1) end
        return 0
    end
    local function colorForMetric(m, v)
        if m == "fps" then
            if v >= 50 then return C.fg elseif v >= 30 then return C.warn else return C.danger end
        elseif m == "ms" then
            if v <= 20 then return C.fg elseif v <= 40 then return C.warn else return C.danger end
        elseif m == "ping" then
            if v <= 80 then return C.fg elseif v <= 150 then return C.warn else return C.danger end
        elseif m == "mem" then
            if v <= 500 then return C.fg elseif v <= 1000 then return C.warn else return C.danger end
        end
        return C.fg
    end

