local function createWrap(tool)
    local h = tool:FindFirstChild("Handle")
    if not h then return end
    for w in pairs(wrap.tool) do if w and w.Parent then w:Destroy() end end
    wrap.tool = {}
    local s = toolHB.scale
    local w = Instance.new("Part")
    w.Name = Stealth.rand()
    w.Size = Vector3.new(
        math.max(h.Size.X * s, 0.05),
        math.max(h.Size.Y * s, 0.05),
        math.max(h.Size.Z * s, 0.05)
    )
    w.CFrame = h.CFrame
    w.Anchored = true
    w.CanCollide = false
    w.CanTouch = true
    w.CanQuery = true
    w.Transparency = 1
    w.Massless = true
    w.CastShadow = false
    w.Parent = workspace
    Debris:AddItem(w, 300)
    wrap.tool[w] = { orig = h, off = CFrame.new(0, 0, -3), scale = s }
end
local function removeWrap(tool)
    local h = tool and tool:FindFirstChild("Handle")
    if not h then return end
    for w, e in pairs(wrap.tool) do
        if e.orig == h then
            if w and w.Parent then w:Destroy() end
            wrap.tool[w] = nil
        end
    end
end
local function applyTool()
    local c = plr.Character
    if not c then return end
    local conts = { c }
    local bp = plr:FindFirstChildOfClass("Backpack")
    if bp then conts[2] = bp end
    for _, ct in ipairs(conts) do
        for _, item in ipairs(ct:GetChildren()) do
            if item:IsA("Tool") then
                local s, on = toolHB.scale, toolHB.on
                for _, p in ipairs(item:GetDescendants()) do
                    if p:IsA("BasePart") and not p:GetAttribute("_fnv") then
                        if not toolHB.saved[p] then
                            toolHB.saved[p] = p.Size
                            p:SetAttribute("_fnv", true)
                        end
                        local o = toolHB.saved[p]
                        if on then
                            pcall(function()
                                p.Size = Vector3.new(
                                    math.max(o.X * s, 0.05),
                                    math.max(o.Y * s, 0.05),
                                    math.max(o.Z * s, 0.05)
                                )
                                p.CanTouch = true
                                p.CanQuery = true
                            end)
                        else
                            pcall(function() p.Size = o end)
                        end
                    end
                end
                if on then createWrap(item) else removeWrap(item) end
            end
        end
    end
end
local function restoreTool()
    for w in pairs(wrap.tool) do if w and w.Parent then w:Destroy() end end
    wrap.tool = {}
    for p, o in pairs(toolHB.saved) do
        if p.Parent then
            pcall(function() p.Size = o end)
            pcall(function() p:SetAttribute("_fnv", nil) end)
        end
    end
    toolHB.saved = {}
end

