--==================================================
-- ATTACK VOCAB
--==================================================
local ATK_KEYS = {
    "attack","damage","hit","punch","swing","slash","shoot","shot",
    "fire","explode","bomb","projectile","bullet","beam","melee","stab",
    "strike","kill","hurt","weapon","sword","blast","pierce","lunge",
    "hazard","hitbox","danger","knife","spike","bone","gaster","blaster",
    "meteor","zone","ring","circle","warn","telegraph","marker","indicator",
    "orb","ball","wave","burst","spark","missile","arrow","shard",
}
local HOT_TAGS = {
    "Projectile","Attack","Damage","Hitbox","Hazard",
    "DamageZone","Bullet","Enemy","Kill","Danger",
    "Telegraph","Warning","DangerZone","AOE","Indicator","AttackPart",
}
local BOSS_KEYS = {
    "boss","босс","elite","guard","enemy","monster","mob","npc",
    "champion","miniboss","raid","chief","lord","king","queen",
}

local nameCache = setmetatable({}, {__mode = "k"})
local function nameMatches(name, keys)
    local c = nameCache[name]
    if c == nil then c = {}; nameCache[name] = c end
    local key = tostring(keys)
    if c[key] ~= nil then return c[key] end
    local n = string.lower(name)
    local r = false
    for i = 1, #keys do
        if string.find(n, keys[i], 1, true) then r = true; break end
    end
    c[key] = r
    return r
end
local function nameIsAttack(n) return nameMatches(n, ATK_KEYS) end
local function nameIsBoss(n)   return nameMatches(n, BOSS_KEYS) end

local tagCache = setmetatable({}, {__mode = "k"})
local function hasHotTag(part)
    local c = tagCache[part]
    if c and os.clock() - c.t < 1 then return c.r end
    local r = false
    for i = 1, #HOT_TAGS do
        if CS:HasTag(part, HOT_TAGS[i]) then r = true; break end
    end
    tagCache[part] = { r = r, t = os.clock() }
    return r
end

--==================================================
-- CHARACTER
--==================================================
local char, primary, hum = nil, nil, nil
local humConn = nil

local function resolvePrimary(c)
    if not c then return nil end
    if c.PrimaryPart and c.PrimaryPart:IsA("BasePart") then return c.PrimaryPart end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    local rp = c:FindFirstChild("RootPart")
    if rp and rp:IsA("BasePart") then return rp end
    for _, n in ipairs({"root","ROOT","Torso","UpperTorso","Head"}) do
        local p = c:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end
local function resolveHumanoid(c)
    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then return h end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("Humanoid") then return d end
    end
    return nil
end
local function ensureValid()
    if not char or not char.Parent then return false end
    if not primary or not primary.Parent or not primary:IsDescendantOf(char) then
        primary = resolvePrimary(char)
    end
    if not hum or not hum.Parent or not hum:IsDescendantOf(char) then
        local nh = resolveHumanoid(char)
        if nh ~= hum then
            hum = nh
            if humConn then humConn:Disconnect(); humConn = nil end
            if hum then
                state._lastHP = hum.Health
            end
        end
    end
    return primary ~= nil
end

--==================================================
-- PROTECT + LEARNED
--==================================================
local protect      = setmetatable({}, {__mode = "k"})
local protectMark  = setmetatable({}, {__mode = "k"})

local function setProtected(part, on)
    if not part or not part:IsA("BasePart") then return end
    if on then
        protect[part] = true
        if not protectMark[part] or not protectMark[part].Parent then
            local h = Instance.new("Highlight")
            h.FillColor = Color3.fromRGB(80, 200, 255)
            h.OutlineColor = Color3.fromRGB(80, 200, 255)
            h.FillTransparency = 0.8
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = part
            h.Parent = part
            protectMark[part] = h
        end
    else
        protect[part] = nil
        if protectMark[part] then
            protectMark[part]:Destroy()
            protectMark[part] = nil
        end
    end
end

-- learned: [key] = { conf = N, name = "...", class = "...", lastSeen = t }
local learned     = {}
local learnedMark = {}

local function patternKey(part)
    return part.Name .. "|" .. part.ClassName
end

local function reinforcePattern(part, weight)
    local key = patternKey(part)
    local l = learned[key]
    if not l then
        l = { conf = 0, name = part.Name, class = part.ClassName, lastSeen = 0 }
        learned[key] = l
    end
    l.conf = l.conf + (weight or 1)
    l.lastSeen = os.clock()
    state._learnedN = 0
    for _ in pairs(learned) do state._learnedN = state._learnedN + 1 end
end

local function isLearnedDanger(part)
    local key = patternKey(part)
    local l = learned[key]
    if l and l.conf >= 2 then return true end
    return false
end

--==================================================
-- BOSS / NPC PROTECT
--==================================================
local function isProtectedEntity(part)
    if not part or not part.Parent then return true end
    if protect[part] then return true end
    if char and part:IsDescendantOf(char) then return true end

    -- большой объект = структура/босс
    if part.Size.Magnitude > 60 then return true end

    -- человекоидный NPC (в самом парте или в модели-родителе)
    if part:FindFirstChildOfClass("Humanoid") then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    if model then
        local h = model:FindFirstChildOfClass("Humanoid")
        if h then
            -- большой HP = босс
            if h.MaxHealth >= 1000 then return true end
            -- имя модели / хитробота = босс
            if nameIsBoss(model.Name) or nameIsBoss(h.Name) then return true end
            -- любой NPC = не трогаем (это тело, не снаряд)
            return true
        end
    end
    -- имя парта как босс
    if nameIsBoss(part.Name) then return true end

    -- высокий HP в самом парте (Health property)
    local hp = part:GetAttribute("Health") or part:GetAttribute("HP")
    if typeof(hp) == "number" and hp >= 1000 then return true end

    return false
end

--==================================================
-- AUTO-DELETE PREDICATE
--==================================================
local function shouldDelete(part)
    if not part or not part.Parent then return false end
    if char and part:IsDescendantOf(char) then return false end
    if isProtectedEntity(part) then return false end

    -- learned pattern = приоритет
    if isLearnedDanger(part) then return true end

    -- attack by name / tag
    if nameIsAttack(part.Name) then return true end
    if hasHotTag(part) then return true end

    -- small fx part
    if part.Size.Magnitude < 30 then
        if part:FindFirstChildWhichIsA("Beam")
           or part:FindFirstChildWhichIsA("ParticleEmitter")
           or part:FindFirstChildWhichIsA("Trail")
           or part:FindFirstChildWhichIsA("Fire") then
            return true
        end
    end

    -- fast small mover
    local vel = part.AssemblyLinearVelocity
    if not part.Anchored and vel.Magnitude > 2 and part.Size.Magnitude < 20 then
        return true
    end
    return false
end

--==================================================
-- AUTO DELETE TICK
--==================================================
local scanParams = OverlapParams.new()
scanParams.FilterType = Enum.RaycastFilterType.Exclude
scanParams.MaxParts = 800

RunService.Heartbeat:Connect(function()
    if not state.autoDelete then return end
    if not ensureValid() then return end
    local now = os.clock()
    if now - state._lastTick < 1/30 then return end
    state._lastTick = now

    local myPos = primary.Position
    scanParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, state.radius, scanParams)

    for i = 1, #parts do
        local p = parts[i]
        if shouldDelete(p) then
            local nm = p.Name
            pcall(function() p:Destroy() end)
            state._deleted += 1
            state._lastDel = nm
        end
    end
end)

--==================================================
-- DAMAGE-LEARN (read-only HealthChanged)
--==================================================
local lastHP = nil
local lastHitAt = 0

local function snapshotAroundHit()
    if not ensureValid() then return end
    local myPos = primary.Position
    scanParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, state.learnRadius, scanParams)
    local candidates = {}

    for i = 1, #parts do
        local p = parts[i]
        if p and p.Parent
           and not (char and p:IsDescendantOf(char))
           and not isProtectedEntity(p) then
            local dist = (p.Position - myPos).Magnitude
            local vel = p.AssemblyLinearVelocity
            local size = p.Size.Magnitude
            local moving = vel.Magnitude > 1
            local close = dist < state.learnRadius * 0.7
            local small = size < 40
            local tagged = hasHotTag(p)
            local named  = nameIsAttack(p.Name)

            -- скорим кто "подозрительнее"
            local score = 0
            if moving then score += 2 end
            if close then score += 1 end
            if small then score += 1 end
            if tagged then score += 3 end
            if named then score += 3 end
            if dist < 15 then score += 2 end

            if score >= 2 then
                candidates[#candidates + 1] = { part = p, score = score, dist = dist }
            end
        end
    end

    -- топ-3 по score → reinforce
    table.sort(candidates, function(a, b) return a.score > b.score end)
    local n = math.min(3, #candidates)
    for i = 1, n do
        reinforcePattern(candidates[i].part, i == 1 and 3 or 1)
    end

    if n > 0 then
        state._lastHitName = candidates[1].part.Name
    end
end

local function bindHumWatch()
    if humConn then humConn:Disconnect(); humConn = nil end
    if not hum then return end
    lastHP = hum.Health
    humConn = hum.HealthChanged:Connect(function(newHP)
        if not state.learnMode then return end
        if lastHP and newHP < lastHP - 0.01 then
            state._hits += 1
            lastHitAt = os.clock()
            -- defer чтоб дать серверу спавнить парты за тот же кадр
            task.defer(snapshotAroundHit)
        end
        lastHP = newHP
    end)
end

-- дергаем bindHumWatch при смене hum (морф)
task.spawn(function()
    while true do
        task.wait(0.3)
        if ensureValid() and hum and humConn == nil then
            bindHumWatch()
        end
    end
end)

