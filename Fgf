-- ============================================================
disableAll = function()
    pcall(function() if flying then stopFly() end end)
    pcall(function() if nvOn then setNV(false) end end)
    pcall(function() if hit.on then hitToggle(false) end end)
    ka.on = false
    ka.target = nil
    esp.on = false
    pcall(function()
        if toolHB.on then
            toolHB.on = false
            restoreTool()
        end
    end)
    pcall(function()
        if mov.ghost then
            setGhost(false)
            updGhost()
        end
    end)
    pcall(function() if noclip.on then setNoclip(false) end end)
    pcall(function() if freeze.on then setFreeze(false) end end)
    aimWarn.on = false
    pcall(function()
        if mov.hb ~= 1.0 then
            for p, o in pairs(mov.origSizes) do
                if p.Parent then pcall(function() p.Size = o end) end
            end
            if FS.hum and mov.hipH then FS.hum.HipHeight = mov.hipH end
            mov.hb = 1.0
        end
    end)
    pcall(function()
        for k, d in pairs(espData) do
            local ch = nil
            if typeof(k) == "Instance" then
                if k:IsA("Player") then ch = k.Character else ch = k end
            end
            hideEsp(d, ch)
        end
        for p in pairs(partSet) do
            local hl = p:FindFirstChild("_fnvph")
            if hl then hl:Destroy() end
        end
    end)
    pcall(function() if kaRing then kaRing.Visible = false end end)
    aimFrame.Visible = false
    aimLabel.Visible = false
    lagOverlay.Visible = false
    espOnPrev = false
    refreshUI()
end

