    pcall(refreshFS)

    if esp.on or ka.on then pcall(scanNpc) end

    if noclip.on and now - noclip.last >= 0.2 then
        noclip.last = now
        local c = plr.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
            end
        end
    end

    if ka.on then
        if now - ka.last >= ka.speed then
            local list = kaScan()
            local best = kaPick(list)
            if best then
                ka.last = now
                if ka.aimOnly then
                    ka.target = best
                    if ka.aimLock and FS.cam then
                        pcall(function() FS.cam.CFrame = CFrame.new(FS.cam.CFrame.Position, best.hrp.Position) end)
                    end
                else
                    ka.target = best
                    pcall(kaAttack, best)
                end
                if kaDbg then
                    kaDbg.Text = string.format("> TGT:%s d=%.0f hp=%.0f", best.name, best.dist, best.hp)
                end
            else
                ka.target = nil
                if kaDbg then
                    kaDbg.Text = ka.npcOnly and "> no NPC (npcOnly)" or "> no targets"
                end
            end
        end
    else
        if kaDbg and kaDbg.Text ~= "> idle" then kaDbg.Text = "> idle" end
        ka.target = nil
    end

    if hit.on and not hit.running and hit.pending and now >= hit.cdUntil then hitRun() end

    if aimWarn.on and now - aimTick >= 0.15 then
        aimTick = now
        pcall(aimScan)
    elseif not aimWarn.on and aimFrame.Visible then
        aimFrame.Visible = false
        aimLabel.Visible = false
    end

    if next(wrap.tool) then
        for w, e in pairs(wrap.tool) do
            local orig = e.orig
            if not orig or not orig.Parent or not w or not w.Parent then
                if w and w.Parent then w:Destroy() end
                wrap.tool[w] = nil
            else
                w.CFrame = orig.CFrame * e.off
                local s = e.scale
                w.Size = Vector3.new(
                    math.max(orig.Size.X * s, 0.05),
                    math.max(orig.Size.Y * s, 0.05),
                    math.max(orig.Size.Z * s, 0.05)
                )
            end
        end
    end

    if now - uiTick >= 0.15 then
        uiTick = now
        if kaDiag then
            kaDiag.Text = string.format("> FTI:%s FCD:%s VU:%s R:%d/%d",
                type(firetouchinterest) == "function" and "Y" or "n",
                type(fireclickdetector) == "function" and "Y" or "n",
                VU and "Y" or "n",
                #remoteCache.damage, #remoteCache.all)
        end
        if abLbl then
            abLbl.Text = string.format("> hits: %d/%d · tp: %s",
                #AB.hitsWindow, AB.maxHitsPerSec,
                AB.teleportReady() and "ready"
                    or string.format("%.1fs", math.max(0, AB.tpCooldown - (now - AB.lastTp))))
        end
        if hit.on and lblHitDbg then
            local cd = math.max(0, hit.cdUntil - now)
            lblHitDbg.Text = string.format("> clicks:%d · CD:%s · %s",
                hit.clicks,
                cd > 0.1 and string.format("%.1fs", cd) or "ready",
                hit.pending and "WAIT" or (hit.running and "RUN" or "idle"))
        end
        if panels.perf and panels.perf.Visible and updateLagPanel then
            pcall(updateLagPanel)
        end
    end

    if now - uiDbgTick >= 0.3 then
        uiDbgTick = now
        if lblParts then
            local n = 0
            for _ in pairs(partSet) do n = n + 1 end
            lblParts.Text = "[ parts: " .. n .. " / " .. esp.maxParts .. " ]"
        end
    end

    if now - statusTick >= 0.5 then
        statusTick = now
        if statusText and not compact.on then
            statusText.Text = string.format("> fnv v6.4 · %s · fly:%s esp:%s ka:%s · %dx%d",
                AB.enabled and "safe" or "raw",
                flying and "ON" or "off",
                esp.on and "ON" or "off",
                ka.on and "ON" or "off",
                frameW, frameH)
        end
    end
end)

