local function applyHB()
    local c = FS.char or plr.Character
    if not c then return end
    local h = FS.hum or c:FindFirstChildOfClass("Humanoid")
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            if not mov.origSizes[p] then mov.origSizes[p] = p.Size end
            local o = mov.origSizes[p]
            local mn = p.Name == "HumanoidRootPart" and 0.3 or 0.001
            pcall(function()
                p.Size = Vector3.new(
                    math.max(o.X * mov.hb, mn),
                    math.max(o.Y * mov.hb, mn),
                    math.max(o.Z * mov.hb, mn)
                )
            end)
        end
    end
    if h then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp and mov.origSizes[hrp] then
            if not mov.hipH then mov.hipH = h.HipHeight end
            h.HipHeight = mov.hipH + (mov.origSizes[hrp].Y - hrp.Size.Y) / 2
        end
    end
end

local function setupMovSafety()
    if mov.hpConn then mov.hpConn:Disconnect() mov.hpConn = nil end
    local h = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if not h then return end
    mov.hpConn = h.HealthChanged:Connect(function(newHp)
        if AB.enabled and newHp < h.MaxHealth * 0.95 and mov.ws > mov.wsCap then
            mov.ws = 16
            if h.Parent then h.WalkSpeed = 16 end
        end
    end)
end

local function setWS(v)
    v = math.clamp(tonumber(v) or 16, 1, 1000)
    mov.ws = v
    if FS.hum then
        FS.hum.WalkSpeed = (AB.enabled and v > mov.wsCap) and mov.wsCap or v
    end
    setupMovSafety()
end
local function setJP(v)
    v = math.clamp(tonumber(v) or 50, 0, 2000)
    mov.jp = v
    if FS.hum then
