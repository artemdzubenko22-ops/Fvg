setCompact = function(on)
    if compact.on == on then return end
    compact.on = on
    if on then
        compact.savedW = frameW
        compact.savedH = frameH
        frameW = 260
        frameH = 36
        frame.Size = UDim2.fromOffset(frameW, frameH)
        tabBar.Visible = false
        content.Visible = false
        statusStrip.Visible = false
        resizeHandle.Visible = false
        expandBtn.Visible = true
        closeB.Visible = false
        dragArea.Size = UDim2.new(1, -56, 1, 0)
        dragArea.Text = "[FNV] ▸ compact · [>] expand"
    else
