kaScan = function()
    local myChar = plr.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return {} end
    local myPos = myHrp.Position
    local myTeam = plr.Team
    local list, seen = {}, {}

    local function consider(m)
        if not m or m == myChar or seen[m] then return end
        seen[m] = true
        local hum = m:FindFirstChildOfClass("Humanoid")
        local hrp = m:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        local owner = Players:GetPlayerFromCharacter(m)
        if owner then
            if owner == plr then return end
            if ka.npcOnly then return end
            if ka.teamCheck and myTeam and owner.Team == myTeam then return end
        end
        local d = (hrp.Position - myPos).Magnitude
        if d > ka.range then return end
        list[#list + 1] = {
            char = m, hum = hum, hrp = hrp, dist = d, hp = hum.Health, mhp = hum.MaxHealth,
            isBoss = (bossSet[m] == true) or (string.find(string.lower(m.Name), "boss", 1, true) ~= nil),
            isPlayer = owner ~= nil,
            name = owner and owner.DisplayName or m.Name,
        }
    end

    if not ka.npcOnly then
        for _, o in ipairs(FS.players) do
            if o ~= plr then consider(o.Character) end
        end
    end
    for m in pairs(npcSet) do consider(m) end

    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

kaPick = function(list)
    local myChar = plr.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil, math.huge end
    local myPos = myHrp.Position
    local best, bs = nil, math.huge
    for _, t in ipairs(list) do
        local score
        if ka.mode == "closest" then
            score = t.dist
        elseif ka.mode == "lowesthp" then
            score = t.hp
        else
            score = t.dist
            if t.isBoss then score = score - 15 end
            if t.isPlayer then score = score - 5 end
            score = score + (t.hp / math.max(t.mhp, 1)) * 10
            local head = t.char:FindFirstChild("Head")
            if head then
                local toMe = myPos - head.Position
                if toMe.Magnitude > 0.1 and head.CFrame.LookVector:Dot(toMe.Unit) > 0.7 then
                    score = score - 8
                end
            end
        end
        if score < bs then
            bs = score
            best = t
        end
    end
    return best, bs
end

kaAttack = function(target)
    if not target or not target.hrp or not target.hrp.Parent then return end
    if not AB.attackReady() then return end
    local myChar = plr.Character
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    if ka.autoEquip then
        local held = myChar:FindFirstChildOfClass("Tool")
        if not held then
            local bp = plr:FindFirstChildOfClass("Backpack")
            if bp then
                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
                        pcall(function() tool.Parent = myChar end)
                        task.wait(AB.jit(0.2))
                        break
                    end
                end
            end
        end
    end

    if ka.tpAttack and AB.teleportReady() then
        local dir = myHrp.Position - target.hrp.Position
        local dest = target.hrp.Position + (dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, -1)) * 3
        pcall(function() myHrp:SetNetworkOwner(plr) end)
        local ok = pcall(function() myChar:PivotTo(CFrame.new(dest)) end)
        pcall(function() myHrp.CFrame = CFrame.new(dest) end)
        if ok then AB.markTeleport() end
    end

    local expanded
    if ka.expandHitbox then
        expanded = {}
        local tool = myChar:FindFirstChildOfClass("Tool")
        if tool then
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then
                    expanded[#expanded + 1] = { part = part, size = part.Size }
                    local o = part.Size
                    pcall(function()
                        part.Size = Vector3.new(
                            math.max(o.X * 5, 15),
                            math.max(o.Y * 5, 15),
                            math.max(o.Z * 5, 15)
                        )
                    end)
                end
            end
        end
    end

    if ka.aimLock and FS.cam then
        pcall(function() FS.cam.CFrame = CFrame.new(FS.cam.CFrame.Position, target.hrp.Position) end)
    end
    if ka.toolActivate or ka.mouseClick then doClick() end

    if ka.touchAttack and type(firetouchinterest) == "function" then
        local tool = myChar:FindFirstChildOfClass("Tool")
        local handle = tool and tool:FindFirstChild("Handle")
        if handle then
            for _, part in ipairs(target.char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(firetouchinterest, handle, part, 0)
                    pcall(firetouchinterest, handle, part, 1)
                end
            end
        end
    end

    if ka.clickDetectors and type(fireclickdetector) == "function" then
        for _, cd in ipairs(target.char:GetDescendants()) do
            if cd:IsA("ClickDetector") then pcall(fireclickdetector, cd) end
        end
    end

    if ka.remoteSpam then
        for _, remote in ipairs(remoteCache.damage) do
            if remote.Parent then
                if remote:IsA("RemoteEvent") then
                    pcall(function() remote:FireServer(target.char) end)
                    pcall(function() remote:FireServer(target.hrp) end)
                elseif remote:IsA("RemoteFunction") then
                    pcall(function() remote:InvokeServer(target.char) end)
                end
            end
        end
    end

    pcall(function() target.hum:TakeDamage(target.hum.MaxHealth) end)

    if expanded then
        for _, e in ipairs(expanded) do
            if e.part and e.part.Parent then pcall(function() e.part.Size = e.size end) end
        end
    end
    AB.attackFired()
end

-- ============================================================
-- HIT COMBO
-- ============================================================
hitStop = function()
    if hit.acTask then
        hit.acTask = nil
    end
    hit.running = false
end

hitStart = function()
    if hit.acTask then return end
    local token = {}
    hit.acTask = token
    task.spawn(function()
        while alive and hit.on and hit.acTask == token do
            if AB.attackReady() then
                doClick()
                hit.clicks = hit.clicks + 1
                AB.attackFired()
            end
            task.wait(0.05)
        end
        if hit.acTask == token then hit.acTask = nil end
    end)
end

hitRun = function()
    if hit.running then return end
    hit.running = true
    hit.pending = false
    local startT = os.clock()
    task.spawn(function()
        task.wait(AB.jit(hit.preDelayMin + math.random() * math.max(0, hit.preDelayMax - hit.preDelayMin)))
        if not hit.on then hit.running = false return end

        local okA, eq = pcall(function() return Enum.KeyCode[hit.slotA] end)
        if not okA or not eq then eq = Enum.KeyCode.Four end
        pressKey(eq)
        if not hit.on then hit.running = false return end

        task.wait(AB.jit(hit.midDelayMin + math.random() * math.max(0, hit.midDelayMax - hit.midDelayMin)))
        if not hit.on then hit.running = false return end
        doClick()

        local okB, fb = pcall(function() return Enum.KeyCode[hit.slotB] end)
        if not okB or not fb then fb = Enum.KeyCode.One end
        pressKey(fb)

        task.wait(AB.jit(hit.postDelay or 0.08))
        if not hit.on then hit.running = false return end

        hit.clicks = 0
        hitStart()
        hit.cdUntil = startT + hit.cd
        hit.running = false
    end)
end

hitReq = function()
    if os.clock() < hit.cdUntil then
        hit.pending = true
        return
    end
    hitRun()
end

hitAttach = function()
    if hit.hConn then hit.hConn:Disconnect() hit.hConn = nil end
    local c = plr.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    hit.lastHp = h.Health
    hit.hConn = h.HealthChanged:Connect(function(newHp)
        if not hit.on then
            hit.lastHp = newHp
            return
        end
        local delta = hit.lastHp - newHp
        hit.lastHp = newHp
        if delta >= hit.thr then hitReq() end
    end)
end

hitToggle = function(on)
    if on == nil then on = not hit.on end
    hit.on = on
    if on then
        hitAttach()
    else
        hitStop()
        hit.pending = false
        if hit.hConn then hit.hConn:Disconnect() hit.hConn = nil end
    end
end

