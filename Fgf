local function cleanupEspEntry(m)
    local d = espData[m]
    if not d then return end
    if m and typeof(m) == "Instance" then
        local hl = m:FindFirstChild("_fnvhl")
        if hl then hl:Destroy() end
    end
    for _, k in ipairs({ "nm", "hb", "hr", "hpt", "tr", "lk" }) do
        local o = d[k]
        if o and o.Parent then o:Destroy() end
    end
    espData[m] = nil
end

local function scanNpc()
    local wantsNpc = (esp.on and (esp.b or esp.bo)) or ka.on
    if not wantsNpc then
        if next(npcSet) then
            for m in pairs(npcSet) do cleanupEspEntry(m) end
            npcSet, bossSet = {}, {}
        end
        return
    end
    local now = os.clock()
    local interval = ka.on and 0.2 or 1.5
    if now - scanTime < interval then return end
    scanTime = now
    local newList, newBoss = {}, {}
    local n = 0
    for _, o in ipairs(workspace:GetDescendants()) do
        if n >= esp.maxBots then break end
        if o:IsA("Humanoid") and o.Health > 0 then
            local m = o.Parent
            if m and m:FindFirstChild("HumanoidRootPart") and not Players:GetPlayerFromCharacter(m) then
                n = n + 1
                newList[m] = true
                if string.find(string.lower(m.Name), "boss", 1, true) then newBoss[m] = true end
            end
        end
    end
    for m in pairs(npcSet) do
        if not newList[m] then cleanupEspEntry(m) end
    end
    npcSet, bossSet = newList, newBoss
end

local function isPartRenderable(p)
    if not p or not p.Parent then return false end
    if p.Transparency >= 0.95 then return false end
    if p.Size.Magnitude < 0.5 then return false end
    local mc = FS.char or plr.Character
    if mc and p:IsDescendantOf(mc) then return false end
    return true
end

local function scanParts()
    if not esp.part then return end
    local now = os.clock()
    if now - partTime < 2.0 then return end
    partTime = now
    local newList = {}
    local n = 0
    local hrp = FS.hrp
    local mp = hrp and hrp.Position
    if not mp then return end
    for _, o in ipairs(workspace:GetDescendants()) do
        if n >= esp.maxParts then break end
        if o:IsA("BasePart") and isPartRenderable(o) then
            if (o.Position - mp).Magnitude <= esp.maxDist then
                n = n + 1
                newList[o] = true
            end
        end
    end
    for p in pairs(partSet) do
        if not newList[p] then
            local hl = p:FindFirstChild("_fnvph")
            if hl then hl:Destroy() end
        end
    end
    partSet = newList
end

local function scanRemotes()
    local all, damage = {}, {}
    local roots = {}
    for _, sn in ipairs({ "ReplicatedStorage", "StarterPack", "Players", "StarterPlayer" }) do
        local ok, s = pcall(game.GetService, game, sn)
        if ok and s then roots[#roots + 1] = s end
    end
    for _, root in ipairs(roots) do
        local ok, list = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, obj in ipairs(list) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    all[#all + 1] = obj
                    local nm = string.lower(obj.Name)
                    local pn = obj.Parent and string.lower(obj.Parent.Name) or ""
                    if nm:find("dmg") or nm:find("damage") or nm:find("hit")
                        or nm:find("hurt") or nm:find("attack") or nm:find("deal")
                        or nm:find("kill") or nm:find("swing") or nm:find("stab")
                        or nm:find("shoot") or nm:find("fire")
                        or pn:find("weapon") or pn:find("combat") or pn:find("tool")
                    then
                        damage[#damage + 1] = obj
                    end
                end
            end
        end
    end
    remoteCache.all, remoteCache.damage = all, damage
end

task.spawn(function()
    while alive do
        if ka.remoteSpam then pcall(scanRemotes) end
        task.wait(30)
    end
end)

