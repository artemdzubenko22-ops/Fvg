local function doClick()
    local c = plr.Character
    local tool = c and c:FindFirstChildOfClass("Tool")

    if type(mouse1click) == "function" then
        if pcall(mouse1click) then
            if tool then pcall(function() tool:Activate() end) end
            return true
        end
    end

    if VU then
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        local mp = Vector2.new(math.floor(vp.X / 2), math.floor(vp.Y / 2))
        local ok = pcall(function()
            VU:CaptureController()
            VU:ClickButton1(mp)
        end)
        if ok then
            if tool then pcall(function() tool:Activate() end) end
            return true
        end
    end

    if type(mouse1press) == "function" and type(mouse1release) == "function" then
        local ok = pcall(function()
            mouse1press()
            task.wait(0.01)
            mouse1release()
        end)
        if ok then
            if tool then pcall(function() tool:Activate() end) end
            return true
        end
    end

    if VIM then
        local cam = FS.cam or workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
        local cx, cy = math.floor(vp.X / 2), math.floor(vp.Y / 2)
        pcall(function() VIM:SendMousePosition(Vector2.new(cx, cy)) end)
        pcall(function()
            VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
            task.wait(0.01)
            VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
        end)
    end

    if tool then pcall(function() tool:Activate() end) end
    return false
end

local function pressKey(kc)
    if not kc then return end
    if type(keypress) == "function" and type(keyrelease) == "function" then
        local ok = pcall(function()
            keypress(kc.Name)
            task.wait(AB.jit(0.03))
            keyrelease(kc.Name)
        end)
        if ok then return true end
    end
    if VIM then
        pcall(function()
            VIM:SendKeyEvent(true, kc, false, game)
            task.wait(AB.jit(0.03))
            VIM:SendKeyEvent(false, kc, false, game)
        end)
        return true
    end
    return false
end

