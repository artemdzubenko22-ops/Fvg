        end
    end)
    ctxItem("Expand", function()
        if expState.selected then
            expState.expanded[expState.selected] = true
            expState.root = expState.selected
            expState.stack = { expState.selected }
            expState.mode = "tree"
            updateCrumb()
            renderTree()
        end
    end)
    ctxItem("Save as Place", function()
        local sel = expState.selected
        if sel and sel:IsA("BasePart") then
            local ok, p = pcall(function() return sel.Position end)
            if ok and p then
                TP.save(sel.Name, p)
                renderPlaces()
            end
        end
    end)

    renderTree = function()
        if not expState.root or not expState.root.Parent and expState.root ~= workspace then
            expState.root = workspace
        end
        for _, c in ipairs(explList:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
        end
        local q = string.lower(expState.filter)
        local results = {}
        local n = 0
        local okScan = pcall(function()
            if expState.mode == "search" then
                for _, inst in ipairs(expState.root:GetDescendants()) do
                    if n >= expState.limit then break end
                    if q == "" or string.find(string.lower(inst.Name), q, 1, true) then
                        if curClass == "all" or inst.ClassName == curClass or inst:IsA(curClass) then
                            n = n + 1
                            results[#results + 1] = { inst = inst, depth = 0 }
                        end
                    end
                end
            else
                local function walk(parent, depth)
                    if n >= expState.limit then return end
                    local kids = parent:GetChildren()
                    table.sort(kids, function(a, b) return a.Name < b.Name end)
                    for _, child in ipairs(kids) do
                        if n >= expState.limit then return end
                        if curClass == "all" or child.ClassName == curClass or child:IsA(curClass) then
                            n = n + 1
                            results[#results + 1] = { inst = child, depth = depth }
                            if expState.expanded[child] then walk(child, depth + 1) end
                        end
                    end
                end
                walk(expState.root, 0)
            end
        end)
        if not okScan then
            info.Text = "> scan failed"
            return
        end
        for _, r in ipairs(results) do
            local inst = r.inst
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, -2, 0, 22)
            row.BackgroundColor3 = (expState.selected == inst) and C.bgRowSel or C.bgRow
            row.BorderSizePixel = 0
            row.Parent = explList
            corner(row, 1)
            local indent = math.min(r.depth, 8) * 12
            local hasKids = #inst:GetChildren() > 0
            local arrow = hasKids and (expState.expanded[inst] and "v " or "> ") or ""
            local nameBtn = Instance.new("TextButton")
            nameBtn.Position = UDim2.fromOffset(4 + indent, 2)
            nameBtn.Size = UDim2.new(1, -90, 0, 18)
            nameBtn.BackgroundTransparency = 1
            nameBtn.Text = arrow .. inst.Name
            nameBtn.TextColor3 = (expState.selected == inst) and C.fgBright or C.fg
            nameBtn.TextSize = 10
            nameBtn.Font = C.font
            nameBtn.TextXAlignment = Enum.TextXAlignment.Left
            nameBtn.TextTruncate = Enum.TextTruncate.AtEnd
            nameBtn.BorderSizePixel = 0
            nameBtn.Parent = row
            nameBtn.MouseButton1Click:Connect(function()
                expState.selected = inst
                if hasKids then expState.expanded[inst] = not expState.expanded[inst] end
                task.spawn(renderTree)
            end)
            nameBtn.MouseButton2Click:Connect(function()
                expState.selected = inst
                local mp = UIS:GetMouseLocation()
                ctx.Position = UDim2.fromOffset(mp.X, mp.Y - 36)
                ctx.Visible = true
            end)
            local clsLbl = Lbl(row, inst.ClassName, UDim2.new(1, -84, 0, 2), UDim2.fromOffset(50, 18), C.fgMuted, 9)
            clsLbl.TextXAlignment = Enum.TextXAlignment.Right
            mkAction(row, "TP", UDim2.new(1, -32, 0, 2), UDim2.fromOffset(28, 18), function()
                expState.selected = inst
                tpTo(inst)
            end)
        end
        info.Text = string.format("> %d · %s · %s", #results, expState.mode, curClass)
        local sel = expState.selected
        if sel and sel.Parent then
            selName.Text = "> " .. sel.Name
            selClass.Text = sel.ClassName
            local ok, path = pcall(function() return sel:GetFullName() end)
            selPath.Text = ok and path or "—"
        else
            selName.Text = "> —"
            selClass.Text = ""
            selPath.Text = ""
        end
    end

    local searchToken = 0
    inpSearch:GetPropertyChangedSignal("Text"):Connect(function()
        expState.filter = inpSearch.Text
        searchToken = searchToken + 1
        local mine = searchToken
        task.delay(0.3, function()
            if not alive or mine ~= searchToken then return end
            expState.mode = (expState.filter ~= "") and "search" or "tree"
            renderTree()
        end)
    end)

    updateCrumb()
    renderTree()
end

