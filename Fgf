local function mkBtn(parent, text, pos, size, bg)
    local b = Instance.new("TextButton")
    b.Position = pos; b.Size = size
    b.BackgroundColor3 = bg or Color3.fromRGB(60, 30, 50)
    b.BorderSizePixel = 0; b.Text = text
    b.TextColor3 = Color3.new(1,1,1); b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = true; b.Parent = parent
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 4); c.Parent = b
    return b
end

