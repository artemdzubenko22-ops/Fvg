hook(UIS.InputBegan, function(i, p)
    if not alive or p or textLock then return end
    if UIS:GetFocusedTextBox() then return end
    local kc = i.KeyCode
    if kc == Binds.map.fly then
        if flying then stopFly() else startFly() end
        if btnFly then
            btnFly.Text = "> ПОЛЁТ: " .. (flying and "ВКЛ [F]" or "ВЫКЛ [F]")
            btnFly.TextColor3 = flying and C.fgBright or C.fg
        end
    elseif kc == Binds.map.nv then
        setNV(not nvOn)
        if btnNV then
            btnNV.Text = "> НОЧЬ: " .. (nvOn and "ВКЛ [N]" or "ВЫКЛ [N]")
            btnNV.TextColor3 = nvOn and C.fgBright or C.fg
        end
    elseif kc == Binds.map.hide or kc == Binds.map.hide2 then
        fullHidden = not fullHidden
        frame.Visible = not fullHidden
        if fullHidden and compact.on then setCompact(false) end
    elseif kc == Binds.map.ka then
        ka.on = not ka.on
        refreshUI()
    elseif kc == Binds.map.esp then
        esp.on = not esp.on
        refreshUI()
    elseif kc == Binds.map.hit then
        hitToggle()
        refreshUI()
    elseif kc == Binds.map.noclip then
        setNoclip(not noclip.on)
        refreshUI()
    elseif kc == Binds.map.freeze then
        setFreeze(not freeze.on)
        refreshUI()
    elseif kc == Binds.map.compact then
        fullHidden = false
        frame.Visible = true
        setCompact(not compact.on)
    elseif kc == Binds.map.lagmode then
        lagGraph.mode = (lagGraph.mode == "panel") and "overlay" or "panel"
    elseif kc == Binds.map.diag then
        if type(setclipboard) == "function" then
            local txt = string.format(
                "FNV v6.4 · %s · fly=%s esp=%s ka=%s hit=%s noclip=%s freeze=%s",
                gameInfo.name, tostring(flying), tostring(esp.on), tostring(ka.on),
                tostring(hit.on), tostring(noclip.on), tostring(freeze.on))
            pcall(setclipboard, txt)
        end
    end
end)

hook(UIS.InputChanged, function(i)
    local isMove = i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
    if not isMove then return end
    if resizing then
        local dx = i.Position.X - resizeStartX
        local dy = i.Position.Y - resizeStartY
        frameW = math.clamp(math.floor(resizeStartW + dx), 320, 900)
        frameH = math.clamp(math.floor(resizeStartH + dy), 360, 900)
        frame.Size = UDim2.fromOffset(frameW, frameH)
    elseif dragging then
        local d = Vector2.new(i.Position.X, i.Position.Y) - dragStart
        frame.Position = UDim2.new(
            dragPos.X.Scale, dragPos.X.Offset + d.X,
            dragPos.Y.Scale, dragPos.Y.Offset + d.Y
        )
    end
end)

hook(UIS.InputEnded, function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
    then
        resizing = false
        dragging = false
    end
end)

dragArea.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
    then
        dragging = true
        dragStart = Vector2.new(i.Position.X, i.Position.Y)
        dragPos = frame.Position
    end
end)

