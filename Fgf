        if c:IsA("TextLabel") then c:Destroy() end
    end
    local list = {}
    for key, l in pairs(learned) do
        list[#list + 1] = { key = key, l = l }
    end
    table.sort(list, function(a, b) return a.l.conf > b.l.conf end)
    for i = 1, math.min(#list, 30) do
        local l = list[i].l
        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.new(1, -2, 0, 14); lb.BackgroundTransparency = 1
        lb.Text = string.format("%s · %s · conf=%d", l.name, l.class, l.conf)
        lb.TextColor3 = l.conf >= 2
            and Color3.fromRGB(255, 130, 130) or Color3.fromRGB(180, 200, 230)
        lb.TextSize = 9; lb.Font = Enum.Font.Code
        lb.TextXAlignment = Enum.TextXAlignment.Left
        lb.TextTruncate = Enum.TextTruncate.AtEnd
        lb.Parent = learnedFrame
    end
    if #list == 0 then
        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.new(1, -2, 0, 14); lb.BackgroundTransparency = 1
        lb.Text = "· пусто — получи урон, паттерны появятся"
        lb.TextColor3 = Color3.fromRGB(150, 150, 170)
        lb.TextSize = 9; lb.Parent = learnedFrame
