-- PERSISTENCE
-- ============================================================
local hasFS = type(writefile) == "function"
    and type(readfile) == "function"
    and type(isfile) == "function"

local function loadLines(path)
    if not hasFS then return {} end
    local ok, exists = pcall(isfile, path)
    if not ok or not exists then return {} end
    local ok2, content = pcall(readfile, path)
    if not ok2 or not content then return {} end
    local out = {}
    for line in content:gmatch("[^\n]+") do out[#out + 1] = line end
    return out
end
local function saveLines(path, lines)
    if not hasFS then return false end
    return (pcall(writefile, path, table.concat(lines, "\n")))
end

