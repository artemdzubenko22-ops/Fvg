local function stopFly()
    flying = false
    flyVel = Vector3.zero
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if linVel then linVel:Destroy() linVel = nil end
    if alignOrient then alignOrient:Destroy() alignOrient = nil end
    if flightHum and flightHum.Parent then
        pcall(function()
            flightHum.PlatformStand = false
            if flightHum.Health > 0 then flightHum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end)
    end
    flightHum = nil
end
local function startFly()
    if flying then return end
    local c = plr.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r or h.Health <= 0 then return end
    flying = true
    flightHum = h
    local att = Instance.new("Attachment")
    att.Parent = r
    att.Name = Stealth.rand()
    linVel = Instance.new("LinearVelocity")
    linVel.Attachment0 = att
    linVel.MaxForce = math.huge
    linVel.RelativeTo = Enum.ActuatorRelativeTo.World
    linVel.VectorVelocity = Vector3.zero
    linVel.Parent = r
    alignOrient = Instance.new("AlignOrientation")
    alignOrient.Attachment0 = att
    alignOrient.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrient.MaxTorque = math.huge
    alignOrient.Responsiveness = 30
    alignOrient.CFrame = r.CFrame
    alignOrient.Parent = r
    h.PlatformStand = true

    local myGen = FS.gen
    local flyHpConn
    flyHpConn = h.HealthChanged:Connect(function(newHp)
        if AB.enabled and newHp < h.MaxHealth * 0.9 then
            if flyHpConn then flyHpConn:Disconnect() flyHpConn = nil end
            stopFly()
        end
    end)

    flyConn = RS.Heartbeat:Connect(function(dt)
        if not alive or not flying or FS.gen ~= myGen then
            if flyHpConn then flyHpConn:Disconnect() flyHpConn = nil end
            stopFly()
            return
        end
        local cc = plr.Character
        if cc ~= c or not r.Parent or h.Health <= 0 then
            if flyHpConn then flyHpConn:Disconnect() flyHpConn = nil end
            stopFly()
            return
        end
        local cam = FS.cam
        if not cam then return end
        local cf = cam.CFrame
        local d = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then d = d + cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then d = d - cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then d = d + cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then d = d - cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.yAxis end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
            d = d - Vector3.yAxis
        end
        local speed = flySpeed
        if AB.enabled and speed > 200 then speed = 200 end
        local target = d.Magnitude > 0 and d.Unit * speed or Vector3.zero
        flyVel = flyVel:Lerp(target, math.clamp(flyAccel * dt, 0, 1))
        linVel.VectorVelocity = flyVel
    end)
end

