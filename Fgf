local function applyMov(ch)
    local h = ch:WaitForChild("Humanoid", 10)
    if not h then return end
    h.WalkSpeed = mov.ws
    h.UseJumpPower = true
    h.JumpPower = mov.jp
    mov.origSizes = {}
    mov.ghostSaved = {}
    mov.hipH = h.HipHeight
    mov.hpConn = nil
    task.wait(0.2)
    if mov.hb ~= 1.0 then applyHB() end
    if mov.ghost then
        task.wait(0.1)
        setGhost(true)
        updGhost()
    end
    if noclip.on then
        task.wait(0.1)
        setNoclip(true)
    end
    if freeze.on then
        task.wait(0.1)
        setFreeze(true)
    end
    setupMovSafety()
end

hook(plr.CharacterAdded, function(ch)
    FS.gen = FS.gen + 1
    if flying then stopFly() end
    task.spawn(function() applyMov(ch) end)
    if nvOn then
        task.spawn(function()
            ch:WaitForChild("HumanoidRootPart", 10)
            if nvOn then updNvLight() end
        end)
    end
    if toolHB.on then
        toolHB.saved = {}
        task.spawn(function()
            ch:WaitForChild("HumanoidRootPart", 10)
            task.wait(0.5)
            if toolHB.on then applyTool() end
        end)
    end
    if hit.on then
        task.spawn(function()
            task.wait(0.6)
            if hit.on then hitAttach() end
        end)
    end
end)

if plr.Character then
    task.spawn(function() applyMov(plr.Character) end)
end

task.spawn(function()
    local bp = plr:WaitForChild("Backpack", 10)
