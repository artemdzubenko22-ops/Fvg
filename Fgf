hook(RS.RenderStepped, function()
    if not alive then return end
    pcall(refreshFS)
    pcall(renderEsp)

    if kaRing and FS.cam then
        local t = ka.target
        if ka.on and t and t.hrp and t.hrp.Parent then
            local vp = FS.cam:WorldToViewportPoint(t.hrp.Position)
            if vp.Z > 0 then
                local sz = math.clamp(2400 / vp.Z, 40, 400)
                kaRing.Visible = true
                kaRing.Position = UDim2.fromOffset(vp.X - sz / 2, vp.Y - sz / 2)
                kaRing.Size = UDim2.fromOffset(sz, sz)
            else
                kaRing.Visible = false
            end
        else
            kaRing.Visible = false
        end
    end

    if FS.hrp and lblPos then
        lblPos.Text = string.format("[ X:%.1f Y:%.1f Z:%.1f ]",
            FS.hrp.Position.X, FS.hrp.Position.Y, FS.hrp.Position.Z)
    end
end)

