aimLabel.TextXAlignment = Enum.TextXAlignment.Center
aimLabel.BorderSizePixel = 0
aimLabel.Visible = false
aimLabel.Parent = espGui
aimLabel.ZIndex = 201

aimScan = function()
    if not aimWarn.on then
        aimFrame.Visible = false
        aimLabel.Visible = false
        return
    end
    local myChar = plr.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then
        aimFrame.Visible = false
        aimLabel.Visible = false
        return
    end
    local myPos = myHrp.Position
    local watchers = {}
    for _, o in ipairs(FS.players) do
        if o ~= plr and o.Character then
            local ch = o.Character
            local head = ch:FindFirstChild("Head")
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if head and hrp then
                local toMe = myPos - head.Position
                local dist = toMe.Magnitude
                if dist > 0.5 and dist <= aimWarn.range and dist > 0.001 then
                    local lv = head.CFrame.LookVector
                    if lv:Dot(toMe.Unit) > aimWarn.dotThresh then
                        watchers[#watchers + 1] = { name = o.DisplayName, dist = dist }
                    end
                end
            end
        end
    end
    if #watchers > 0 then
        aimFrame.Visible = true
        aimLabel.Visible = true
        table.sort(watchers, function(a, b) return a.dist < b.dist end)
