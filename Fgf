--==================================================
-- DANGER CRITERIA
--==================================================
local ATK_KEYS = {
    "attack","damage","hit","punch","swing","slash","shoot","shot",
    "fire","explode","bomb","projectile","bullet","beam","melee","stab",
    "strike","kill","hurt","weapon","sword","blast","pierce","lunge",
    "hazard","hitbox","danger","knife","spike","bone","gaster","blaster",
    "meteor","zone","ring","circle","warn","telegraph","marker","indicator",
}
local HOT_TAGS = {
    "Projectile","Attack","Damage","Hitbox","Hazard",
    "DamageZone","Bullet","Enemy","Kill","Danger",
    "Telegraph","Warning","DangerZone","AOE","Indicator",
}

local nameCache = setmetatable({}, {__mode = "k"})
local function nameIsAttack(name)
    local c = nameCache[name]
    if c ~= nil then return c end
    local n = string.lower(name)
    local r = false
    for i = 1, #ATK_KEYS do
        if string.find(n, ATK_KEYS[i], 1, true) then r = true; break end
    end
    nameCache[name] = r
    return r
end

local tagCache = setmetatable({}, {__mode = "k"})
local function hasHotTag(part)
    local c = tagCache[part]
    if c and os.clock() - c.t < 1 then return c.r end
    local r = false
    for i = 1, #HOT_TAGS do
        if CS:HasTag(part, HOT_TAGS[i]) then r = true; break end
    end
    tagCache[part] = { r = r, t = os.clock() }
    return r
end

--==================================================
-- CHARACTER (morph-safe)
--==================================================
local char, primary, hum = nil, nil, nil
local function resolvePrimary(c)
    if not c then return nil end
    if c.PrimaryPart and c.PrimaryPart:IsA("BasePart") then return c.PrimaryPart end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp end
    local rp = c:FindFirstChild("RootPart")
    if rp and rp:IsA("BasePart") then return rp end
    for _, n in ipairs({"root","ROOT","Torso","UpperTorso","Head"}) do
        local p = c:FindFirstChild(n)
        if p and p:IsA("BasePart") then return p end
    end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end
local function resolveHumanoid(c)
    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then return h end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("Humanoid") then return d end
    end
    return nil
end
local function ensureValid()
    if not char or not char.Parent then return false end
    if not primary or not primary.Parent or not primary:IsDescendantOf(char) then
        primary = resolvePrimary(char)
    end
    if not hum or not hum.Parent or not hum:IsDescendantOf(char) then
        hum = resolveHumanoid(char)
    end
    return primary ~= nil
end
local function updateChar(c)
    char = c; primary = nil; hum = nil
    if c then
        primary = resolvePrimary(c)
        hum = resolveHumanoid(c)
    end
end
player.CharacterAdded:Connect(updateChar)
player.CharacterRemoving:Connect(function() char, primary, hum = nil, nil, nil end)
if player.Character then updateChar(player.Character) end
task.spawn(function()
    while true do
        task.wait(0.15)
        if player.Character and player.Character ~= char then
            updateChar(player.Character)
        elseif char then
            ensureValid()
        end
    end
end)

--==================================================
-- PROTECT LIST (RMB)
--==================================================
local protect = setmetatable({}, {__mode = "k"})
local protectMark = setmetatable({}, {__mode = "k"})

local function setProtected(part, on)
    if not part or not part:IsA("BasePart") then return end
    if on then
        protect[part] = true
        if not protectMark[part] or not protectMark[part].Parent then
            local h = Instance.new("Highlight")
            h.FillColor = Color3.fromRGB(80, 200, 255)
            h.OutlineColor = Color3.fromRGB(80, 200, 255)
            h.FillTransparency = 0.8
            h.OutlineTransparency = 0
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = part
            h.Parent = part
            protectMark[part] = h
        end
    else
        protect[part] = nil
        if protectMark[part] then
            protectMark[part]:Destroy()
            protectMark[part] = nil
        end
    end
end

--==================================================
-- AUTO DELETE
--==================================================
local scanParams = OverlapParams.new()
scanParams.FilterType = Enum.RaycastFilterType.Exclude
scanParams.MaxParts = 800

local function shouldDelete(part)
    if not part or not part.Parent then return false end
    if char and part:IsDescendantOf(char) then return false end
    if protect[part] then return false end
    if part.Anchored and part.Size.Magnitude > 80 then return false end

    if nameIsAttack(part.Name) then return true end
    if hasHotTag(part) then return true end

    -- маленький парт с fx-ребёнком = снаряд/визуал атаки
    if part.Size.Magnitude < 30 then
        if part:FindFirstChildWhichIsA("Beam")
           or part:FindFirstChildWhichIsA("ParticleEmitter")
           or part:FindFirstChildWhichIsA("Trail") then return true end
    end

    -- маленький движущийся не-анкоренный = летящий снаряд/моб
    local vel = part.AssemblyLinearVelocity
    if not part.Anchored and vel.Magnitude > 2 and part.Size.Magnitude < 20 then
        return true
    end

    return false
end

local function autoDeleteTick()
    if not state.autoDelete then return end
    if not ensureValid() then return end
    local now = os.clock()
    if now - state._lastTick < 1/30 then return end
    state._lastTick = now

    local myPos = primary.Position
    scanParams.FilterDescendantsInstances = { char }
    local parts = workspace:GetPartBoundsInRadius(myPos, state.radius, scanParams)

    for i = 1, #parts do
        local p = parts[i]
        if shouldDelete(p) then
            local pname = p.Name
            pcall(function() p:Destroy() end)
            state._deleted += 1
            state._lastDel = pname
        end
    end
end

RunService.Heartbeat:Connect(autoDeleteTick)

--==================================================
-- CLICK DELETE / PROTECT
--==================================================
local camera = workspace.CurrentCamera
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    camera = workspace.CurrentCamera
end)

local clickParams = RaycastParams.new()
clickParams.FilterType = Enum.RaycastFilterType.Exclude

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not camera then camera = workspace.CurrentCamera end
    if not camera then return end

    local isLMB = input.UserInputType == Enum.UserInputType.MouseButton1
    local isRMB = input.UserInputType == Enum.UserInputType.MouseButton2
    if not (isLMB or isRMB) then return end
    if isLMB and not state.clickDelete then return end
    if isRMB and not state.protectMode then return end

    local mp = UIS:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mp.X, mp.Y)
    clickParams.FilterDescendantsInstances = { char, camera }
    local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, clickParams)

    if not result or not result.Instance or not result.Instance:IsA("BasePart") then return end
    local part = result.Instance
    if char and part:IsDescendantOf(char) then return end

    if isLMB and state.clickDelete then
        local pname = part.Name
        pcall(function() part:Destroy() end)
        state._deleted += 1
        state._lastDel = pname
    elseif isRMB and state.protectMode then
        setProtected(part, not protect[part])
    end
end)

