local function makeTab(label, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1 / 8, 0, 1, 0)
    b.BackgroundColor3 = C.bgPanel
    b.Text = "[" .. label .. "]"
    b.TextColor3 = C.fgDim
    b.TextSize = 10
    b.Font = C.font
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = tabBar
    b.MouseButton1Down:Connect(function() switchTab(key) end)
    b.MouseEnter:Connect(function()
        if currentTab ~= key then b.TextColor3 = C.fg end
    end)
    b.MouseLeave:Connect(function()
        if currentTab ~= key then b.TextColor3 = C.fgDim end
    end)
    tabs[key] = b
end
