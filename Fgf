local TP = { places = {}, file = "fnv_places_" .. tostring(game.PlaceId or 0) .. ".txt" }
do
    local function sanitize(name)
        if type(name) ~= "string" then name = tostring(name or "") end
        return (name:gsub("[|\t\n\r]", "_"))
    end
    function TP.index(entry)
        for i, e in ipairs(TP.places) do
            if e == entry then return i end
        end
        return nil
    end
    function TP.persist()
        local lines = table.create(#TP.places)
        for i, e in ipairs(TP.places) do
            lines[i] = string.format("%s\t%.2f\t%.2f\t%.2f", sanitize(e.name), e.pos.X, e.pos.Y, e.pos.Z)
        end
        return saveLines(TP.file, lines)
    end
    function TP.load()
        TP.places = {}
        for _, line in ipairs(loadLines(TP.file)) do
            local nm, x, y, z = line:match("^([^\t]+)\t([^\t]+)\t([^\t]+)\t([^\t]+)$")
            if not nm then
                nm, x, y, z = line:match("^([^|]+)|([^|]+)|([^|]+)|([^|]+)$")
            end
            if nm then
                TP.places[#TP.places + 1] = {
                    name = sanitize(nm),
                    pos = Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0),
                }
            end
        end
    end
    function TP.save(name, pos)
        name = sanitize(name)
        if name == "" then name = string.format("%.0f,%.0f", pos.X, pos.Z) end
        for i = #TP.places, 1, -1 do
            if TP.places[i].name == name then table.remove(TP.places, i) end
        end
        table.insert(TP.places, 1, { name = name, pos = pos })
        TP.persist()
    end
    function TP.removeEntry(entry)
        local i = TP.index(entry)
        if i then table.remove(TP.places, i) TP.persist() end
    end
    TP.load()
end

