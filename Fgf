-- CLICK DELETE / PROTECT
--==================================================
local camera = workspace.CurrentCamera
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    camera = workspace.CurrentCamera
end)

local clickParams = RaycastParams.new()
clickParams.FilterType = Enum.RaycastFilterType.Exclude

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not camera then camera = workspace.CurrentCamera end
    if not camera then return end
    local isLMB = input.UserInputType == Enum.UserInputType.MouseButton1
    local isRMB = input.UserInputType == Enum.UserInputType.MouseButton2
    if not (isLMB or isRMB) then return end
    if isLMB and not state.clickDelete then return end
    if isRMB and not state.protectMode then return end

    local mp = UIS:GetMouseLocation()
    local ray = camera:ViewportPointToRay(mp.X, mp.Y)
    clickParams.FilterDescendantsInstances = { char, camera }
    local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, clickParams)
    if not result or not result.Instance or not result.Instance:IsA("BasePart") then return end
    local part = result.Instance
    if char and part:IsDescendantOf(char) then return end

    if isLMB then
        local nm = part.Name
        pcall(function() part:Destroy() end)
        state._deleted += 1
        state._lastDel = nm
    elseif isRMB then
        setProtected(part, not protect[part])
    end
end)

