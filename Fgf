        lagMode = lagGraph.mode, lagMetric = lagGraph.metric,
        uiW = frameW, uiH = frameH,
    }
end

function Config.persist()
    if not hasFS then return false end
    local cfg = Config.build()
    local lines = {}
    local function push(k, v)
        if type(v) == "table" and #v == 3 then
            lines[#lines + 1] = k .. "=" .. v[1] .. "," .. v[2] .. "," .. v[3]
        elseif type(v) == "boolean" then
            lines[#lines + 1] = k .. "=" .. (v and "true" or "false")
        else
            lines[#lines + 1] = k .. "=" .. tostring(v)
        end
    end
    for k, v in pairs(cfg) do push(k, v) end
    for action, kc in pairs(Binds.map) do
        lines[#lines + 1] = "bind_" .. action .. "=" .. kc.Name
    end
    return saveLines(Config.file, lines)
end

function Config.read()
    if not hasFS then return nil end
    local ok, exists = pcall(isfile, Config.file)
    if not ok or not exists then return nil end
    local ok2, content = pcall(readfile, Config.file)
    if not ok2 or not content then return nil end
    local cfg = { binds = {} }
    for line in content:gmatch("[^\n]+") do
        local k, v = line:match("^([^=]+)=(.+)$")
        if k and v and v ~= "nil" then
            if k:sub(1, 5) == "bind_" then
                cfg.binds[k:sub(6)] = v
            elseif v == "true" then cfg[k] = true
            elseif v == "false" then cfg[k] = false
            elseif v:find(",", 1, true) then
                local a, b, c = v:match("^([^,]+),([^,]+),([^,]+)$")
                if a then cfg[k] = { tonumber(a) or 0, tonumber(b) or 0, tonumber(c) or 0 } end
            else
                cfg[k] = tonumber(v) or v
            end
        end
    end
    return cfg
end

function Config.apply(cfg)
    if type(cfg) ~= "table" then return end
    local function num(k, d)
        local v = tonumber(cfg[k])
        if v == nil then return d end
        return v
    end
    local function bool(k, d)
        local v = cfg[k]
        if type(v) ~= "boolean" then return d end
        return v
    end
    local function col(k, d)
        local t = cfg[k]
        if type(t) == "table" and #t >= 3 then return Color3.new(t[1], t[2], t[3]) end
        return d
    end

    flySpeed = num("flySpeed", flySpeed)
    mov.ws = num("movWS", mov.ws)
    mov.jp = num("movJP", mov.jp)
    mov.hb = num("movHB", mov.hb)
    esp.on = bool("espOn", esp.on)
    esp.p = bool("espP", esp.p)
    esp.b = bool("espB", esp.b)
    esp.bo = bool("espBO", esp.bo)
    esp.part = bool("espPart", esp.part)
    esp.name = bool("espName", esp.name)
    esp.hp = bool("espHP", esp.hp)
    esp.tracer = bool("espTracer", esp.tracer)
    esp.look = bool("espLook", esp.look)
    esp.visOnly = bool("espVisOnly", esp.visOnly)
    esp.alwaysTop = bool("espAlwaysTop", esp.alwaysTop)
    esp.maxDist = num("espMaxDist", esp.maxDist)
    esp.textSize = num("espTextSize", esp.textSize)
    esp.col = col("espCol", esp.col)
    esp.botCol = col("espBotCol", esp.botCol)
    esp.bossCol = col("espBossCol", esp.bossCol)
    esp.partCol = col("espPartCol", esp.partCol)
    ka.range = num("kaRange", ka.range)
    ka.speed = num("kaSpeed", ka.speed)
    if type(cfg.kaMode) == "string" then ka.mode = cfg.kaMode end
    ka.npcOnly = bool("kaNPCOnly", ka.npcOnly)
    ka.aimOnly = bool("kaAimOnly", ka.aimOnly)
    ka.aimLock = bool("kaAimLock", ka.aimLock)
    ka.autoEquip = bool("kaAutoEquip", ka.autoEquip)
    ka.toolActivate = bool("kaToolActivate", ka.toolActivate)
    ka.expandHitbox = bool("kaExpandHitbox", ka.expandHitbox)
    ka.mouseClick = bool("kaMouseClick", ka.mouseClick)
    ka.touchAttack = bool("kaTouchAttack", ka.touchAttack)
    ka.clickDetectors = bool("kaClickDetectors", ka.clickDetectors)
    ka.remoteSpam = bool("kaRemoteSpam", ka.remoteSpam)
    ka.tpAttack = bool("kaTPAttack", ka.tpAttack)
    ka.teamCheck = bool("kaTeamCheck", ka.teamCheck)
    AB.enabled = bool("abEnabled", AB.enabled)
    AB.maxHitsPerSec = num("abMaxHits", AB.maxHitsPerSec)
    AB.tpCooldown = num("abTpCd", AB.tpCooldown)
    aimWarn.on = bool("aimWarnOn", aimWarn.on)
    aimWarn.range = num("aimWarnRange", aimWarn.range)
    if type(cfg.lagMode) == "string" then lagGraph.mode = cfg.lagMode end
    if type(cfg.lagMetric) == "string" then lagGraph.metric = cfg.lagMetric end

    if type(cfg.binds) == "table" then
        for k, v in pairs(cfg.binds) do
            local ok, kc = pcall(function() return Enum.KeyCode[v] end)
            if ok and kc then Binds.map[k] = kc end
        end
    end
    if FS.hum then
        setWS(mov.ws)
