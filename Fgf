local AB = { enabled = true, maxHitsPerSec = 5, hitsWindow = {}, tpCooldown = 1.0, lastTp = 0, jitter = 0.04 }
function AB.attackReady()
    if not AB.enabled then return true end
    local now = os.clock()
    local w = AB.hitsWindow
    while #w > 0 and now - w[1] > 1.0 do table.remove(w, 1) end
    return #w < AB.maxHitsPerSec
end
function AB.attackFired()
    if not AB.enabled then return end
    AB.hitsWindow[#AB.hitsWindow + 1] = os.clock()
end
function AB.teleportReady()
    if not AB.enabled then return true end
    return (os.clock() - AB.lastTp) >= AB.tpCooldown
end
function AB.markTeleport()
    if not AB.enabled then return end
    AB.lastTp = os.clock()
end
function AB.jit(t)
    if not AB.enabled then return t end
    return t + (math.random() * 2 - 1) * AB.jitter
end

